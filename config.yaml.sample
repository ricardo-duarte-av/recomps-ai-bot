matrix:
  homeserver: https://matrix.example.org
  user_id: "@recompbot:example.org"
  password: "change-me"
  device_name: recompbot
  # Encrypts the E2EE keys stored in the database. Generate once and never change it
  # (e.g. `openssl rand -hex 32`), or the bot will lose access to its encryption keys.
  pickle_key: "change-me"
  # Rooms the bot works in (room IDs or aliases). Anything else is ignored.
  allowed_rooms:
    - "!abcdefghijklmnop:example.org"
    - "#recomps:example.org"
  # Minimum power level to add/remove entries and confirm with reactions.
  moderator_level: 50

openai:
  api_key: "sk-..."
  model: gpt-5-mini
  # Optional: "minimal" / "low" keep replies fast and cheap on GPT-5 models.
  # Leave empty for models that don't support reasoning_effort.
  reasoning_effort: low
  # Optional: OpenAI-compatible endpoint.
  base_url: ""

github:
  # Optional personal access token (no scopes needed) to raise the API rate limit
  # from 60 to 5000 requests/hour.
  token: ""

forges:
  # Repos can be on any git host. github.com, gitlab.com, codeberg.org, gitea.com,
  # git.sr.ht and the big GNOME/KDE/freedesktop/Debian GitLabs are known out of the box.
  # Any other host is auto-detected (Gitea/Forgejo API, then GitLab API, then raw
  # README URLs for cgit/SourceHut-style hosts, then the repo's web page).
  # List a host here only to skip detection or to give it an API token
  # (needed for private repos or rate limits).
  hosts: []
  #  - host: git.example.org
  #    type: gitlab          # github | gitlab | gitea | forgejo | generic
  #    token: ""
  #  - host: github.mycompany.com
  #    type: github          # GitHub Enterprise
  #    token: ""
  # Fetching from private/loopback IPs is refused by default. Enable this if your
  # self-hosted forge is on your LAN.
  allow_private_networks: false

database:
  path: /data/sqlite.db

web:
  # Read-only, searchable page listing everything in the database.
  enabled: true
  # Address and port to listen on. Keep 0.0.0.0 inside Docker; change the port
  # here and in docker-compose.yaml together.
  listen: "0.0.0.0:8080"
  title: "Recomps & Decomps"
